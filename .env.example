# Copy to .env (gitignored) and fill in.
#
# OpenTrader gateway app token. All market data goes through the gateway
# (src-tauri/src/data/gateway.rs). The token is compiled in: src-tauri/build.rs
# takes OPENTRADER_GATEWAY_TOKEN from the build environment, else from this
# file. A build without it has no market data. Never commit the real value.
OPENTRADER_GATEWAY_TOKEN=

# OpenAlgo broker (browser web access, src/data/providers/openalgo.ts).
# Vite inlines these into the client bundle at build/dev startup — local dev
# only, never ship a build containing them. Never commit real values.
VITE_OPENALGO_BASE=
VITE_OPENALGO_WS=
VITE_OPENALGO_KEY=
#
# Data provider (optional; default: gateway; `openalgo` = the OpenAlgo
# provider of the desktop build).
# DATA_PROVIDER=gateway
# DATA_PROVIDER=openalgo

# ── Desktop: OpenAlgo (src-tauri) ────────────────────────────────────────────
# The Rust provider reads these from the environment (dotenvy loads this file
# at startup, see src-tauri/src/lib.rs). `DATA_PROVIDER=openalgo` selects it;
# the host/ws pair and the key are the same values the browser side uses.
# The key rides only in the request payload — it is never logged.
OPENALGO_HOST=
OPENALGO_WS=
OPENALGO_KEY=
