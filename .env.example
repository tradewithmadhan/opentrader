# Copy to .env (gitignored) and fill in.
#
# OpenTrader gateway app token. All Massive data goes through the gateway
# (src-tauri/src/data/gateway.rs). The token is compiled in: src-tauri/build.rs
# takes OPENTRADER_GATEWAY_TOKEN from the build environment, else from this
# file. A build without it has no market data. Never commit the real value.
OPENTRADER_GATEWAY_TOKEN=

# OpenAlgo broker (browser web access, src/data/providers/openalgo.ts).
# Vite inlines these into the client bundle at build/dev startup — local dev
# only, never ship a build containing them. Never commit real values.
VITE_OPENALGO_BASE=
VITE_OPENALGO_WS=
VITE_OPENALGO_KEY=
